# Copy to .env for local development.
MONGODB_URI=mongodb://127.0.0.1:27017/pressroom
SESSION_SECRET=replace-with-a-long-random-string

# First admin account, created automatically (with sample content) when the database is empty.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Optional
SITE_NAME=Pressroom
SITE_TAGLINE=Stories, ideas and notes from Lagos and beyond
# BASE_URL=https://your-app.onrender.com
# SEED_ON_START=false
# SESSION_AUTOREMOVE=interval   # only for Mongo-compatible servers without TTL indexes
