<aside class="sidebar">
  <section class="panel">
    <h2 class="panel__title">Categories</h2>
    <ul class="plain">
      <% sidebar.categories.forEach(c => { %><li><a href="/category/<%= c.slug %>"><%= c.name %></a></li><% }) %>
    </ul>
  </section>
  <% if (sidebar.popular.length) { %>
  <section class="panel">
    <h2 class="panel__title">Most read</h2>
    <ol class="ranked">
      <% sidebar.popular.forEach(p => { %><li><a href="/post/<%= p.slug %>"><%= p.title %></a></li><% }) %>
    </ol>
  </section>
  <% } %>
  <% if (sidebar.tags.length) { %>
  <section class="panel">
    <h2 class="panel__title">Tags</h2>
    <p class="tags"><% sidebar.tags.forEach(t => { %><a class="tag" href="/tag/<%= t %>">#<%= t %></a><% }) %></p>
  </section>
  <% } %>
</aside>
