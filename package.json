{
  "name": "pressroom-cms",
  "version": "1.0.0",
  "description": "Pressroom: a content management system with editorial workflow, scheduling, versioning, SEO scoring and a headless API (Node.js, Express, MongoDB)",
  "main": "server.js",
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node src/seed.js",
    "coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude=\"tests/**\" \"tests/**/*.test.js\""
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "connect-mongo": "^6.0.0",
    "dotenv": "^18.0.6",
    "ejs": "^7.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongodb": "^7.7.0",
    "mongoose": "^9.11.1",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "quill": "^2.0.3",
    "sanitize-html": "^2.18.0",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
